<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MD Fit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackgroundColor</string>
		<key>UIImageName</key>
		<string>MDFitLogo</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCalendarsUsageDescription</key>
	<string>MD Fit needs access to your calendar to schedule workouts, events, and program reminders so you never miss a session.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MD Fit needs full access to your calendar to schedule workouts, events, and program reminders so you never miss a session.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>MD Fit needs access to add workouts and events to your calendar so you never miss a session.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>MD Fit reads your workouts, heart rate, steps and active energy from Apple Health so your progress, streaks and workout stats stay accurate. Your health data stays on your device and is never sold or used for advertising.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>MD Fit saves the workouts you finish in the app to Apple Health, so all your training is in one place.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>MD Fit sends notifications to remind you about upcoming workouts, events, and to help maintain your fitness streak.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mdfitsrq.MDfit</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mdfit</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.mdfitsrq.MDfit.generate</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Start a workout</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Workout generator</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>figure.strengthtraining.traditional</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.mdfitsrq.MDfit.pain</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Pain Tool</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Find what helps</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>figure.stand</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.mdfitsrq.MDfit.progress</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>My progress</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Streak, XP and calendar</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>chart.bar.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.mdfitsrq.MDfit.messages</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Message Dr. Jared</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Your conversation</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>message.fill</string>
		</dict>
	</array>
</dict>
</plist>
