<resources>
    <style name="Theme.MDfit" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/mdfit_navy</item>
        <item name="android:statusBarColor">@color/mdfit_navy</item>
        <item name="android:navigationBarColor">@color/mdfit_navy</item>
        <item name="colorPrimary">@color/mdfit_gold</item>
        <item name="colorAccent">@color/mdfit_gold</item>
    </style>
    <style name="Theme.MDfit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mdfit_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MDfit</item>
    </style>
</resources>
